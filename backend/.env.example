# Copy to .env and adjust. Every value can also be a real environment variable
# (real env vars win over .env). Never commit .env.

# --- Application ---------------------------------------------------------------
APP_NAME="Onezae Health API"
ENVIRONMENT=local            # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173   # used in password-reset links

# --- Security ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
COOKIE_SECURE=false          # must be true in production (HTTPS)
COOKIE_SAMESITE=lax

# --- Database ------------------------------------------------------------------
# MySQL 8.0+ (InnoDB, utf8mb4). Create the database with:
#   CREATE DATABASE onezae CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'onezae'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON onezae.* TO 'onezae'@'localhost';
DATABASE_URL=mysql+aiomysql://onezae:<password>@127.0.0.1:3306/onezae?charset=utf8mb4
# Zero-setup alternative for a quick local try-out (not for production):
# DATABASE_URL=sqlite+aiosqlite:///./app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800      # keep below MySQL wait_timeout

# --- HTTP ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173   # comma-separated
ALLOWED_HOSTS=*

LOG_LEVEL=INFO
LOG_JSON=false               # true in production for log aggregation

# --- Clinic & scheduling ---------------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata         # IANA name; schedules are wall-clock in this zone
APPOINTMENT_DURATION_MINUTES=30
BOOKING_MIN_LEAD_MINUTES=60          # earliest bookable slot from now
BOOKING_WINDOW_DAYS=60               # how far ahead patients can book
CANCELLATION_CUTOFF_HOURS=2          # patients can't cancel later than this
REMINDER_LEAD_HOURS=24

# --- Pagination & rate limits ----------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/60                # requests/seconds per IP on auth endpoints
RATE_LIMIT_AI=20/300                 # per user
RATE_LIMIT_UPLOAD=30/300             # per user

# --- Cloudinary (chat & profile images) -----------------------------------------
# Server-side only; never expose the secret to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=onezae
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- AI assistant (Groq) --------------------------------------------------------
# Server-side only. The React app calls this API, never Groq directly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.2
AI_MAX_ITERATIONS=6
AI_MAX_TOKENS=12000
AI_TIMEOUT_SECONDS=45
AI_MAX_RECOMMENDED_DOCTORS=3
EMERGENCY_PHONE_NUMBER=112

# --- Email ----------------------------------------------------------------------
EMAIL_BACKEND=console        # console (logs a notice) | disabled
EMAIL_FROM=no-reply@example.com

# Copy to .env.local. Only VITE_* variables are exposed to the browser bundle,
# and they are baked in at build time - never put secrets here.

VITE_APP_NAME=Onezae
# Relative path works in dev (Vite proxy) and in prod (nginx serves FE + proxies /api).
# Use an absolute URL only if the API lives on a different origin.
VITE_API_BASE_URL=/api/v1

# Dev server only: where the Vite proxy forwards /api
VITE_DEV_API_PROXY=http://127.0.0.1:8000
